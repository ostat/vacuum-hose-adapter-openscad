#!/bin/sh

# Get current branch
BRANCH=$(git rev-parse --abbrev-ref HEAD)



STAGED=$(git diff --cached --name-only)
SCAD_CHANGED=$(echo "$STAGED" | grep -E '\.scad$')

if [ -z "$SCAD_CHANGED" ]; then
    echo "No .scad files changed. Skipping compile."
    exit 0
fi

echo "Running OpenSCAD test script..."
powershell.exe -ExecutionPolicy Bypass -File scripts/test-render.ps1
if [ $? -ne 0 ]; then
  echo "test failed. Commit aborted."
  exit 1
fi

# Combined files are no longer committed; they are published as GitHub releases
# by .github/workflows/generate-combined.yaml. Running the combine script here
# only checks that combining still works.
echo "Running OpenSCAD combine script..."
powershell.exe -ExecutionPolicy Bypass -File scripts/combined-openscad_script.ps1
if [ $? -ne 0 ]; then
  echo "Combine failed. Commit aborted."
  exit 1
fi